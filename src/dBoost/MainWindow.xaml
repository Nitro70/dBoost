<Window x:Class="DBoost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DBoost.App.Controls"
        xmlns:vm="clr-namespace:DBoost.App.ViewModels"
        Title="dBoost" Icon="Assets/dBoost.ico"
        Width="1080" Height="740" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        UseLayoutRounding="True">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="dBoost" ProgressState="{Binding TaskbarState, Mode=OneWay}" ProgressValue="{Binding OverallProgress, Mode=OneWay}" />
    </Window.TaskbarItemInfo>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding AddFilesCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding AddFolderCommand}" />
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding StartCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ header -->
        <Grid Grid.Row="0" Margin="20,14,20,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/dBoost-256.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="dBoost" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Make audio and video louder or quieter" Style="{StaticResource Caption}" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Advanced}" VerticalAlignment="Center"
                          AutomationProperties.Name="Advanced mode"
                          ToolTip="Show extra tools: boost parts of a file, single tracks, auto level, tone, fades, formats and preview">
                    <TextBlock Text="Advanced" FontSize="14" />
                </CheckBox>
                <Button x:Name="MenuButton" Style="{StaticResource IconButtonStyle}" Content="&#xE712;" Margin="12,0,0,0"
                        AutomationProperties.Name="More options" ToolTip="More options" Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu" Opened="MoreMenu_Opened">
                            <MenuItem Header="Add files..." InputGestureText="Ctrl+O" Command="{Binding AddFilesCommand}" />
                            <MenuItem Header="Add a folder..." InputGestureText="Ctrl+Shift+O" Command="{Binding AddFolderCommand}" />
                            <Separator />
                            <MenuItem x:Name="ContextMenuToggle" Header="Show &quot;Boost volume with dBoost&quot; when right-clicking files in Explorer"
                                      IsCheckable="True" Click="ContextMenuToggle_Click" />
                            <MenuItem x:Name="SendToToggle" Header="Add dBoost to the Explorer &quot;Send to&quot; menu"
                                      IsCheckable="True" Click="SendToToggle_Click" />
                            <Separator />
                            <MenuItem Header="About dBoost" Click="About_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================ content -->
        <Grid Grid.Row="1" Margin="20,8,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- ======================== left: files, and the per-file editor in advanced mode -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="16,10,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileCountText}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding AddFilesCommand}" ToolTip="Add files (Ctrl+O)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,6,0" />
                                        <TextBlock Text="Add files" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding AddFolderCommand}" ToolTip="Add every audio and video file in a folder (Ctrl+Shift+O)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" Margin="0,0,6,0" />
                                        <TextBlock Text="Add folder" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE73E;" Command="{Binding ClearFinishedCommand}"
                                        AutomationProperties.Name="Remove finished files" ToolTip="Remove finished files from the list" />
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" Command="{Binding ClearCommand}"
                                        AutomationProperties.Name="Clear the list" ToolTip="Clear the list (your files are not touched)" />
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="FileList" Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                 SelectionMode="Extended" Background="Transparent" BorderThickness="0" Padding="6,0,6,6"
                                 ItemContainerStyle="{StaticResource FileRowStyle}"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.Name="Files">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItem}">
                                    <Grid Margin="2,6" Background="Transparent" ToolTip="{Binding Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open the boosted file" Command="{Binding OpenResultCommand, Source={StaticResource Vm}}"
                                                          CommandParameter="{Binding}" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                                                <MenuItem Header="Show in folder" Command="{Binding ShowInExplorerCommand, Source={StaticResource Vm}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Remove from list" Command="{Binding RemoveCommand, Source={StaticResource Vm}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <!-- thumbnail from Windows, or a glyph until it arrives -->
                                        <Border Width="48" Height="48" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Center" FontSize="20"
                                                           Text="{Binding IsVideo, Converter={StaticResource VideoGlyph}}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                </TextBlock>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <Button Style="{StaticResource LinkButtonStyle}" FontSize="12" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                    Content="{Binding OutputName}" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding ShowInExplorerCommand, Source={StaticResource Vm}}" CommandParameter="{Binding}"
                                                    ToolTip="Show the boosted file in its folder (you can also drag this row into another app)" />
                                            <TextBlock Text="{Binding Message}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- status -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="80">
                                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Right" Margin="0,0,0,4"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    ToolTip="This file has its own volume change">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                                        <Binding Path="UseOwnGain" />
                                                        <Binding Path="Advanced" Source="{StaticResource Vm}" />
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="{Binding OwnGainDb, Converter={StaticResource DbText}}" FontSize="11"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <ProgressBar Width="110" Height="4" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                         IsIndeterminate="{Binding IsIndeterminate}"
                                                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Margin="0,0,5,0" FontSize="12"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                           Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE783;" Margin="0,0,5,0" FontSize="12"
                                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                           Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#xE711;" FontSize="11"
                                                Width="28" Height="28" VerticalAlignment="Center"
                                                Command="{Binding RemoveCommand, Source={StaticResource Vm}}" CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsBusy, Source={StaticResource Vm}, Converter={StaticResource Not}}"
                                                AutomationProperties.Name="Remove from list" ToolTip="Remove from the list (the file itself is not touched)" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- empty state: one big drop target -->
                        <Grid Grid.Row="1" Margin="16,4,16,16" Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="5 4"
                                       Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Fill="Transparent" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="40" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Drop audio or video files here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" FontSize="13"
                                           Text="Mix any kinds: MP3, WAV, FLAC, M4A, MP4, MKV, MOV and many more. Whole folders work too, and so does pasting files with Ctrl+V." />
                                <Button Style="{StaticResource AccentButtonStyle}" Content="Browse for files" HorizontalAlignment="Center"
                                        Margin="0,16,0,0" Padding="18,7" Command="{Binding AddFilesCommand}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ======================== per-file editor (advanced) -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,12"
                        DataContext="{Binding SelectedFile}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                            <Binding Path="Advanced" Source="{StaticResource Vm}" />
                            <Binding Path="HasSelection" Source="{StaticResource Vm}" />
                        </MultiBinding>
                    </Border.Visibility>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- title, track picker, preview and measure -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Parts of " Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                <ComboBox x:Name="TrackPicker" Margin="10,0,0,0" MinWidth="150" MaxWidth="240" ItemsSource="{Binding Tracks}"
                                          SelectedItem="{Binding WaveformTrack}" DisplayMemberPath="ShortLabel" SelectionChanged="TrackPicker_SelectionChanged"
                                          Visibility="{Binding HasMultipleTracks, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Which track the waveform and preview use" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding PreviewCommand, Source={StaticResource Vm}}"
                                        ToolTip="Listen to 10 seconds with every change applied, from the marker">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Preview" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding PreviewOriginalCommand, Source={StaticResource Vm}}"
                                        ToolTip="Listen to the same 10 seconds unchanged, to compare">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,6,0" />
                                        <TextBlock Text="Original" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding StopPreviewCommand, Source={StaticResource Vm}}"
                                        ToolTip="Stop playing (Space starts and stops the preview)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" Margin="0,0,6,0" />
                                        <TextBlock Text="Stop" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding AnalyzeCommand, Source={StaticResource Vm}}"
                                        ToolTip="Measure how loud this track is and how far it can go before clipping">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Margin="0,0,6,0" />
                                        <TextBlock Text="Measure" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <c:WaveformView x:Name="Wave" Grid.Row="1" Height="128"
                                        GainDb="{Binding EffectiveGainDb, Source={StaticResource Vm}}"
                                        Waveform="{Binding Waveform}" Segments="{Binding Segments}"
                                        SelectedSegment="{Binding SelectedSegment, Source={StaticResource Vm}}"
                                        CursorSeconds="{Binding CursorSeconds}"
                                        Playhead="{Binding Playhead, Source={StaticResource Vm}}"
                                        Limiter="{Binding PreventClipping, Source={StaticResource Vm}}"
                                        CeilingDb="{Binding CeilingDb, Source={StaticResource Vm}}"
                                        Message="{Binding WaveformMessage}"
                                        AutomationProperties.Name="Waveform. Drag across it to boost just that part." />

                        <!-- analysis result -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding AnalysisText, Converter={StaticResource NullToVis}}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding AnalysisText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButtonStyle}" Content="Use that for this file" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                    Command="{Binding UseHeadroomCommand, Source={StaticResource Vm}}"
                                    Visibility="{Binding CanUseHeadroom, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Give this file its own volume change: as loud as it can go without clipping" />
                        </StackPanel>

                        <!-- parts list, own volume, tracks -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               Text="Drag across the waveform to boost just that part. Click it to set where the preview starts."
                                               Visibility="{Binding HasSegments, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <TextBlock Text="Boosted parts" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Visibility="{Binding HasSegments, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                              Visibility="{Binding HasSegments, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Segments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SegmentItem}">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Width="78" Text="{Binding StartText, UpdateSourceTrigger=LostFocus}"
                                                             AutomationProperties.Name="Part start" ToolTip="Start (seconds, or minutes:seconds)" />
                                                    <TextBlock Grid.Column="1" Text="to" Margin="8,0" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Grid.Column="2" Width="78" Text="{Binding EndText, UpdateSourceTrigger=LostFocus}"
                                                             AutomationProperties.Name="Part end" ToolTip="End (seconds, or minutes:seconds)" />
                                                    <c:GainEditor Grid.Column="3" Margin="10,0,0,0" Value="{Binding GainDb}" AutomationProperties.Name="Part volume change" />
                                                    <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" Margin="4,0,0,0"
                                                            Command="{Binding RemoveSegmentCommand, Source={StaticResource Vm}}" CommandParameter="{Binding}"
                                                            AutomationProperties.Name="Remove part" ToolTip="Remove this part" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding AddSegmentCommand, Source={StaticResource Vm}}"
                                            ToolTip="Add a part at the marker">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,6,0" />
                                            <TextBlock Text="Add part" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SubtleButtonStyle}" Content="Remove all parts"
                                            Command="{Binding ClearSegmentsCommand, Source={StaticResource Vm}}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Width="250">
                                <CheckBox Content="Own volume change for this file" IsChecked="{Binding UseOwnGain}"
                                          ToolTip="Use a different dB change for this file than for the others" />
                                <c:GainEditor Margin="0,6,0,0" Value="{Binding OwnGainDb}" IsEnabled="{Binding UseOwnGain}"
                                              AutomationProperties.Name="This file's volume change" />

                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasMultipleTracks, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Boost these audio tracks" FontWeight="SemiBold" />
                                    <TextBlock Text="Unticked tracks are copied unchanged." Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Tracks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TrackItem}">
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsBoosted}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================== right: volume and advanced settings -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Volume change" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="for every file" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                                           Visibility="{Binding Advanced, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <c:GainEditor IsLarge="True" Value="{Binding GainDb}" IsEnabled="{Binding IsAutoLevelOn, Converter={StaticResource Not}}"
                                          AutomationProperties.Name="Volume change in decibels" />
                            <Slider Margin="0,14,0,0" Minimum="{Binding SliderMin}" Maximum="{Binding SliderMax}" Value="{Binding GainDb}"
                                    SmallChange="0.5" LargeChange="3" TickFrequency="0.5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    IsEnabled="{Binding IsAutoLevelOn, Converter={StaticResource Not}}"
                                    AutomationProperties.Name="Volume change slider" />
                            <Grid Margin="2,2,2,0">
                                <TextBlock Text="{Binding SliderMin, StringFormat={}{0} dB}" Style="{StaticResource Caption}" HorizontalAlignment="Left" />
                                <TextBlock Text="0" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SliderMax, StringFormat=+{0} dB}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            </Grid>
                            <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Center" IsEnabled="{Binding IsAutoLevelOn, Converter={StaticResource Not}}">
                                <Button Style="{StaticResource ChipButtonStyle}" Content="-6" Command="{Binding SetGainCommand}" CommandParameter="-6" />
                                <Button Style="{StaticResource ChipButtonStyle}" Content="+3" Command="{Binding SetGainCommand}" CommandParameter="3" />
                                <Button Style="{StaticResource ChipButtonStyle}" Content="+6" Command="{Binding SetGainCommand}" CommandParameter="6" />
                                <Button Style="{StaticResource ChipButtonStyle}" Content="+10" Command="{Binding SetGainCommand}" CommandParameter="10" />
                                <Button Style="{StaticResource ChipButtonStyle}" Content="+20" Command="{Binding SetGainCommand}" CommandParameter="20" />
                            </WrapPanel>
                            <TextBlock Text="{Binding GainDescription}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,6,0,0"
                                       Text="Drag the number or the slider, or type any amount. Put a minus in front to make it quieter (for example -6). There is no limit." />
                        </StackPanel>
                    </Border>

                    <!-- advanced settings -->
                    <StackPanel Visibility="{Binding Advanced, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Level" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Auto level" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AutoLevelChoices}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          SelectedValue="{Binding AutoLevel}" HorizontalAlignment="Stretch"
                                          ToolTip="Instead of one fixed change, measure each file and pick its change automatically" />
                                <Grid Margin="0,8,0,0" Visibility="{Binding IsAutoLevelOn, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Target" Style="{StaticResource FieldLabel}" />
                                    <c:GainEditor Grid.Column="1" Value="{Binding AutoLevelTarget}" Unit="{Binding AutoLevelUnit}" Maximum="0"
                                                  AutomationProperties.Name="Auto level target"
                                                  ToolTip="-14 LUFS is what YouTube and Spotify use; -1 dB peak is just under clipping" />
                                </Grid>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding PreventClipping}" Margin="0,14,0,0">
                                    <TextBlock Text="Prevent clipping" />
                                </CheckBox>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="A limiter keeps loud peaks clean instead of letting them crackle. Turn it off for a raw boost." />
                                <Grid Margin="0,8,0,0" Visibility="{Binding PreventClipping, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ceiling" Style="{StaticResource FieldLabel}" />
                                    <c:GainEditor Grid.Column="1" Value="{Binding CeilingDb}" Minimum="-24" Maximum="0" Step="0.1"
                                                  AutomationProperties.Name="Limiter ceiling" ToolTip="The loudest a peak may get (0 is full scale)" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Tone and channels" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Bass" Style="{StaticResource FieldLabel}" />
                                    <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding BassDb}" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True" AutomationProperties.Name="Bass" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding BassDb, Converter={StaticResource DbText}}" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="Treble" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding TrebleDb}" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True" AutomationProperties.Name="Treble" Margin="0,8,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TrebleDb, Converter={StaticResource DbText}}" Style="{StaticResource FieldLabel}"
                                               HorizontalAlignment="Right" Margin="0,8,0,0" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Left channel" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <c:GainEditor Value="{Binding LeftDb}" AutomationProperties.Name="Left channel change" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Right channel" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <c:GainEditor Value="{Binding RightDb}" AutomationProperties.Name="Right channel change" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Fades" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Fade in" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <c:GainEditor Value="{Binding FadeIn}" Unit="s" ShowSign="False" Minimum="0" Step="0.5" ScrubPerPixel="0.05"
                                                      AutomationProperties.Name="Fade in seconds" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Fade out" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <c:GainEditor Value="{Binding FadeOut}" Unit="s" ShowSign="False" Minimum="0" Step="0.5" ScrubPerPixel="0.05"
                                                      AutomationProperties.Name="Fade out seconds" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Output" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Format" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding FormatChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Format}" />
                                <TextBlock Text="{Binding FormatHint}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Visibility="{Binding FormatHint, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="Quality" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                <ComboBox ItemsSource="{Binding BitrateChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Bitrate}"
                                          ToolTip="For MP3, M4A, OGG and Opus. Lossless formats ignore this." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================ footer -->
        <Border Grid.Row="2" Padding="20,12,20,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel>
                        <TextBlock Text="Save to" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OutputDisplay}" MaxWidth="300" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputDisplay}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Button Style="{StaticResource SubtleButtonStyle}" Content="Change..." Margin="10,0,0,0" Command="{Binding ChooseFolderCommand}"
                            ToolTip="Save the boosted files into one folder" />
                    <Button Style="{StaticResource SubtleButtonStyle}" Content="Next to originals" Command="{Binding UseOriginalFolderCommand}"
                            Visibility="{Binding UseOutputFolder, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8DA;" Command="{Binding OpenOutputFolderCommand}"
                            AutomationProperties.Name="Open the output folder" ToolTip="Open the folder with the boosted files" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" Style="{StaticResource Caption}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding OverallProgress, Mode=OneWay}" Margin="0,6,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancel" Margin="0,0,8,0" Padding="16,8" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource AccentButtonStyle}" MinWidth="180" Height="40" FontSize="15" Padding="18,6"
                            Command="{Binding StartCommand}" ToolTip="Ctrl+Enter. Your original files are never changed.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" Margin="0,0,10,0" FontSize="16" />
                            <TextBlock Text="{Binding StartButtonText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ drag-over overlay -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="3" Visibility="Collapsed" AllowDrop="True">
            <Rectangle x:Name="DropSurface" Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.88" />
            <Rectangle Margin="18" RadiusX="12" RadiusY="12" StrokeThickness="2.5" StrokeDashArray="6 4" IsHitTestVisible="False"
                       Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Drop to add" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
